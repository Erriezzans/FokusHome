<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/primaryShadeDarkColor"
    android:orientation="vertical">

    <Space
        android:layout_width="match_parent"
        android:layout_height="2dp" />

    <LinearLayout
        android:id="@+id/infoRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="top"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/moodText"
            style="@style/TextDefault"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:textSize="15sp" />

        <LinearLayout
            android:id="@+id/weatherBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/weatherIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/weatherTemp"
                style="@style/TextSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false" />
        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/clockLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:gravity="end|bottom"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:visibility="gone">

        <TextClock
            android:id="@+id/clockTime"
            style="@style/TextDefault"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="30sp" />

        <TextClock
            android:id="@+id/clockDate"
            style="@style/TextSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:paddingBottom="4dp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:animateLayoutChanges="true"
        android:orientation="horizontal">

        <androidx.appcompat.widget.SearchView
            android:id="@+id/search"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:layout_weight="1"
            android:gravity="end"
            android:imeOptions="actionSearch"
            android:paddingHorizontal="7dp"
            android:paddingVertical="0dp"
            android:textCursorDrawable="@null"
            app:closeIcon="@null"
            app:iconifiedByDefault="false"
            app:queryBackground="@null"
            app:queryHint="@string/fokus_search_hint"
            app:searchIcon="@drawable/ic_search"
            app:theme="@style/AppSearchText" />

        <TextView
            android:id="@+id/appRename"
            style="@style/TextSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="20dp"
            android:paddingVertical="@dimen/app_padding_vertical"
            android:text="@string/rename"
            android:textAllCaps="true"
            android:visibility="gone" />

        <TextView
            android:id="@+id/focusAction"
            style="@style/TextSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="12dp"
            android:paddingVertical="@dimen/app_padding_vertical"
            android:textAllCaps="true"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/exitAction"
            style="@style/TextSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="12dp"
            android:paddingVertical="@dimen/app_padding_vertical"
            android:text="@string/fokus_exit"
            android:textAllCaps="true"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/settingsAction"
            style="@style/TextSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="16dp"
            android:alpha="0.6"
            android:paddingVertical="@dimen/app_padding_vertical"
            android:text="@string/open_settings"
            android:textAllCaps="true"
            android:textSize="13sp"
            android:visibility="gone" />

    </LinearLayout>

    <Space
        android:id="@+id/barSpace"
        android:layout_width="match_parent"
        android:layout_height="6dp" />

    <LinearLayout
        android:id="@+id/recentRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingEnd="32dp"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/listContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="16dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:fadingEdgeLength="56dp"
            android:paddingEnd="32dp"
            android:requiresFadingEdge="vertical" />

        <app.olauncher.ui.AlphabetIndexView
            android:id="@+id/alphabetIndex"
            android:layout_width="32dp"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:layout_marginVertical="8dp"
            android:visibility="invisible" />

        <TextView
            android:id="@+id/letterBubble"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="top|end"
            android:layout_marginEnd="56dp"
            android:background="@drawable/bg_letter_bubble"
            android:elevation="8dp"
            android:gravity="center"
            android:textColor="?attr/primaryInverseColor"
            android:textSize="36sp"
            android:textStyle="bold"
            android:visibility="gone" />

    </FrameLayout>

</LinearLayout>